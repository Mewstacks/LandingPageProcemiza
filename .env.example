# Opcional. Sem ID, nenhuma medição e nenhum banner.
NEXT_PUBLIC_GA_ID=

# Relatório por e-mail (POST /api/relatorio). Sem RESEND_API_KEY e LEADS_TO_EMAIL o endpoint responde 503.
RESEND_API_KEY=
# "Procemiza <relatorio@subdominio-verificado>"
DEFAULT_FROM_EMAIL=
LEADS_TO_EMAIL=
REPLY_TO_EMAIL=
# Opcional: Cloudflare Turnstile (sem as duas chaves não há desafio)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: registro do lead no CRMew (sem as duas, só o e-mail da equipe)
CRMEW_INGEST_URL=
CRMEW_INGEST_TOKEN=
CRMEW_FORM_ID=site-calculadora
